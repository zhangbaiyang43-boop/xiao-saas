    "@vant/weapp": "^1.11.7",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.30",
    "@dcloudio/uni-automator": "3.0.0-alpha-5000820260420001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5000820260420001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5000820260420001",
