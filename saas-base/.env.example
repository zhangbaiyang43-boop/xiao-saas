APP_NAME=Multi-tenant Member Management SaaS
APP_VERSION=1.0.0

DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/example_db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=your-secret-key-here-must-be-at-least-32-characters-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Staff Authentication — H5 password + trusted device (formal path).
STAFF_TRUST_DEVICE_DAYS=30
STAFF_ACCESS_TOKEN_MINUTES=120
STAFF_DEVICE_COOKIE_ENABLED=true
STAFF_DEVICE_COOKIE_NAME=staff_device
STAFF_DEVICE_COOKIE_PATH=/api
# 小程序订阅消息模板 ID（微信公众平台 → 订阅消息 → 我的模板）
WECHAT_COUPON_REMINDER_TEMPLATE_ID=ufLleND4WNNqN-sZubt4sZP25XVaH1XSin2Dew3uwSc
WECHAT_QUEUE_REMINDER_TEMPLATE_ID=g0qjXdu6Y76_xr7186_NRlMoolEWS9-B0XaeO5OAEpo
WECHAT_ORDER_SUCCESS_TEMPLATE_ID=GPbNB8JgaI7zBbZZHlMtv4n9NlPBcAQSIF25dzbaD2Q
WECHAT_PICKUP_REMINDER_TEMPLATE_ID=Z20rjKIxj2jnXswL6vVVz0dg6xNlcDpvLXb4luFBv-k

# 微信支付服务商（ISV）配置 —— 申请服务商资质后填入
WX_SP_MCHID=
WX_SP_API_KEY_V3=
WX_SP_CERT_SERIAL=
WX_SP_PRIVATE_KEY=

# 平台中控台
PLATFORM_REGISTER_KEY=
SUPER_ADMIN_PASSWORD=
# 动态口令二次验证（TOTP），运行 python scripts/generate_totp_secret.py 生成后绑定进认证器 App
SUPER_ADMIN_TOTP_SECRET=
# 商户微信支付私钥/APIv3密钥落库加密密钥，运行 python scripts/generate_encryption_key.py 生成
SECRET_ENCRYPTION_KEY=

WEWORK_CORP_ID=
WEWORK_AGENT_ID=
WEWORK_SECRET=
WEWORK_TOKEN=
WEWORK_ENCODING_AES_KEY=
WEWORK_CALLBACK_URL=
WEWORK_STAFF_USERID=
WEWORK_TENANT_ID=

DEBUG=true

# 默认关闭，只有本地/测试环境需要用模拟充值、模拟支付时才手动打开。
# 生产环境务必保持 false（或不设置）——不要跟着 DEBUG 一起开。
ALLOW_MOCK_MONEY_ENDPOINTS=false

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_TENANT=300/minute

CACHE_DEFAULT_TTL=1800
CACHE_PREFIX=saas:

LOCK_DEFAULT_TIMEOUT=10
LOCK_RETRY_DELAY=100

PAGE_DEFAULT_LIMIT=20
PAGE_MAX_LIMIT=200
SLOW_REQUEST_MS=100

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=50
DB_POOL_RECYCLE=1800
AUTO_CREATE_TABLES=false
